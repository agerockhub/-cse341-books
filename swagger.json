{
  "openapi": "3.0.0",
  "info": {
    "title": "Books API",
    "version": "1.0.0",
    "description": "API documentation for the CSE 341 Books Web Service"
  },
  "servers": [
    {
      "url": "https://cse341-books-n3bj.onrender.com"
    }
  ],
  "paths": {
    "/books": {
      "get": {
        "summary": "Retrieve all books",
        "description": "Returns a list of all books in the database.",
        "responses": {
          "200": {
            "description": "Successfully retrieved all books."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Retrieve a single book by ID",
        "description": "Returns a book matching the provided ID.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The unique ID of the book.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the requested book."
          },
          "404": {
            "description": "Book not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {},
  "tags": []
}